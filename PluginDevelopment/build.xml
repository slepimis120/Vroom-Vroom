<project name="MyPlugin" default="rebuild">
	
	<property file="build.local.properties"/>
	<property file="build.properties"/>
	
	<path id="mylibs">
		<fileset dir="lib" includes="*.jar"/>
	</path>
	
	<path id="magicdraw-libs">
		<fileset dir="${MAGICDRAW_HOME}/lib" includes="**/*.jar"/>
	</path>
	
	<path id="all-libs">
		<path refid="mylibs"/>
		<path refid="magicdraw-libs"/>
	</path>
	
	<target name="clean">
		<delete dir="build"/>
		<delete dir="dist"/>
	</target>

	<target name="compile">
		<mkdir dir="build/classes"/>
		<javac srcdir="src"
		       destdir="build/classes"
		       source="1.7"
		       target="1.7"
		       debug="yes"
		       includeantruntime="false"
		       fork="true"
		       executable="${JDK8_JAVAC}"
		       classpathref="all-libs">
			<compilerarg line="-Xlint:-options"/>
		</javac>
	</target>

	<target name="build" depends="compile">
		<mkdir dir="dist"/>
		<jar destfile="dist/myplugin.jar" basedir="build/classes"/>
	</target>
		
	<target name="deploy" depends="build">
		<mkdir dir="${MAGICDRAW_HOME}/plugins/myplugin"/>
		<copy file="dist/myplugin.jar" todir="${MAGICDRAW_HOME}/plugins/myplugin"/>
		<copy file="resources/plugin.xml" todir="${MAGICDRAW_HOME}/plugins/myplugin"/>
		<copy file="resources/ProjectOptions.xml" todir="${MAGICDRAW_HOME}/plugins/myplugin"/>
		<copy todir="${MAGICDRAW_HOME}/plugins/myplugin">
			<fileset dir="lib" includes="*.jar"/>
		</copy>
		<copy todir="${MAGICDRAW_HOME}/plugins/myplugin/templates">
			<fileset dir="resources/templates" includes="*.ftl"/>
		</copy>
	</target>
	
	<target name="rebuild" depends="clean,deploy"
	        description="CLean build and deploy in MagicDraw"/>
</project>